# Frontend Production Environment Variables
# Used by Vercel during build and runtime

# Backend API URL - MUST match your Render backend deployment
# This is used in: src/services/api.js and socket connections
VITE_API_URL=https://manielectrical-backend.onrender.com

# Socket.IO URL - Must be the same as API URL for WebSocket connections
VITE_SOCKET_URL=https://manielectrical-backend.onrender.com

# Google OAuth Configuration
# MUST be set in Vercel Environment Variables dashboard for security
VITE_GOOGLE_CLIENT_ID=736784299634-41e6n7sk2253u5h8qs1kbkv0v7kfld60.apps.googleusercontent.com
