# ============================================
# PRODUCTION DEPLOYMENT GUIDE
# ============================================
# Copy this file to .env and fill in your values
# For local development: use PORT=50004 only
# For production (Render): PORT will be auto-set by platform

# ============================================
# 1. MongoDB Atlas Connection
# ============================================
# Get your connection string from:
# MongoDB Atlas Dashboard → Databases → Connect → Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&ssl=true

# Optional: Separate database for product catalog
PRODUCTS_MONGO_URI=

# ============================================
# 2. Server Configuration
# ============================================
# LOCAL DEV: Use PORT=50004 (matches vite.config.js proxy)
# PRODUCTION (Render): LEAVE BLANK (Render auto-assigns PORT)
# The code uses: process.env.PORT || 5000
PORT=50004
NODE_ENV=development

# ============================================
# 3. Backend Base URL (for image URLs)
# ============================================
# LOCAL DEV: Leave empty (uses relative paths)
# PRODUCTION: https://manielectrical-backend.onrender.com
BASE_URL=

# ============================================
# 4. JWT Authentication
# ============================================
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRE=30d

# ============================================
# 5. Google OAuth (Optional)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_here

# ============================================
# 6. CORS Configuration
# ============================================
# Frontend URLs that can access this API
# LOCAL DEV: http://localhost:3003 (automatically allowed)
# PRODUCTION: https://manielectrical.vercel.app
CORS_ORIGIN=https://manielectrical.vercel.app

# ============================================
# 7. Payment Gateway - Razorpay (Optional)
# ============================================
# Get from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ============================================
# 8. Cloud Storage - Cloudinary (Optional)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# 9. WhatsApp Notifications - UltraMsg (Optional)
# ============================================
# Create free account at: https://ultramsg.com
ULTRAMSG_INSTANCE_ID=your_instance_id_here
ULTRAMSG_TOKEN=your_token_here
